# ===== AI智能获客助手 环境变量模板 =====
# 复制为 .env 后填写实际值

# 数据库
DB_NAME=ai_customer
DB_USER=ai_customer
DB_PASSWORD=ai_customer

# AI 模型（OpenAI 兼容协议）
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# JWT 密钥（生产必须改为至少 32 字节随机串）
JWT_SECRET=ai-customer-dev-secret-change-me-in-prod-0123456789
JWT_EXPIRE_HOURS=72

# 敏感配置加密密钥（32 字节）
CONFIG_ENC_KEY=change-me-32bytes-encryption-key!!
